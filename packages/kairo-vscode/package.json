{
  "name": "kairo",
  "displayName": "Kairo",
  "description": "IDE panel for Kairo Runtime — Gentle control plane: Ahora, Workflow, Equipo, Atención.",
  "version": "0.8.0",
  "publisher": "kal-elsam",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "kairo-workspace",
        "label": "Kairo (workspace)"
      }
    ],
    "commands": [
      {
        "command": "kairo.openPanel",
        "title": "Kairo: Open Panel"
      },
      {
        "command": "kairo.setup",
        "title": "Kairo: Setup"
      },
      {
        "command": "kairo.connectAgent",
        "title": "Kairo: Connect Agent (MCP)"
      },
      {
        "command": "kairo.openCockpit",
        "title": "Kairo: Open Terminal Cockpit"
      },
      {
        "command": "kairo.sync",
        "title": "Kairo: Sync"
      },
      {
        "command": "kairo.doctor",
        "title": "Kairo: Doctor"
      },
      {
        "command": "kairo.refresh",
        "title": "Kairo: Refresh Status"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "kairo-panel-container",
          "title": "Kairo",
          "icon": "media/kairo.svg"
        }
      ]
    },
    "views": {
      "kairo-panel-container": [
        {
          "type": "webview",
          "id": "kairo.panel",
          "name": "Kairo"
        }
      ],
      "explorer": [
        {
          "id": "kairo.status",
          "name": "Kairo",
          "visibility": "collapsed"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "npx --yes @vscode/vsce@3.9.2 package --no-dependencies"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kal-elSam/harness.git",
    "directory": "packages/kairo-vscode"
  }
}
