{
  "name": "@kal-elsam/kairo-runtime",
  "version": "0.36.0",
  "description": "Kairo — the cost and quota layer for gentle-ai: picks the model and provider for every role across Claude, Codex, OpenCode and Cursor while keeping quota in view.",
  "type": "module",
  "homepage": "https://github.com/Kal-elSam/harness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kal-elSam/harness.git"
  },
  "bugs": {
    "url": "https://github.com/Kal-elSam/harness/issues"
  },
  "bin": {
    "kairo": "./bin/kairo.js",
    "kairo-runtime": "./bin/kairo-runtime.js",
    "harness": "./bin/harness.js",
    "agentic-harness": "./bin/harness.js",
    "sgs-harness": "./bin/harness.js",
    "harness-sgs": "./bin/harness.js"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "repo-template",
    "global-template",
    "prompts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test 'test/**/*.js' 'test/**/*.mjs' 'test/**/*.cjs'",
    "test:cool": "node --test --test-concurrency=1 'test/**/*.js' 'test/**/*.mjs' 'test/**/*.cjs'",
    "doctor": "node ./bin/kairo.js doctor",
    "smoke": "bash scripts/smoke-test.sh",
    "ux:smoke": "bash scripts/ux-smoke-test.sh",
    "smoke:registry": "bash scripts/registry-smoke-test.sh",
    "smoke:clean-install": "bash scripts/clean-install-smoke.sh",
    "smoke:installer": "bash scripts/installer-smoke-test.sh",
    "smoke:bridge": "bash scripts/bridge-smoke-test.sh",
    "release:check": "node scripts/check-release-commit.mjs",
    "release:published": "node scripts/check-published-release.mjs"
  },
  "keywords": [
    "ai",
    "agents",
    "codex",
    "cursor",
    "pi",
    "kairo",
    "kairo-runtime",
    "harness",
    "sdd",
    "tdd"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [],
    "ignoredBuiltDependencies": [
      "@google/genai",
      "esbuild",
      "protobufjs"
    ]
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@modelcontextprotocol/server": "2.0.0",
    "ansi-escapes": "^7.3.0",
    "zod": "4.4.3"
  }
}
